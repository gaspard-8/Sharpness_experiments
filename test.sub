# Submit on the cluster through: bash submit-wandb.sh
project_dir             = /nethome/gtomas/projects/sharpness_experiments
log_dir                 = /scratch/gtomas/logs/sharpness_experiments
result_dir              = /scratch/gtomas/sharpness_experiments/results
image                   = docker.coli.uni-saarland.de/gtomas/sharpness-experiments:v1
experiment_args         =

universe                = docker
docker_image            = $(image)
initialdir              = /nethome/gtomas
executable              = $(project_dir)/run-test.sh
arguments               = $(experiment_args)

getenv                  = WANDB_API_KEY, WANDB_PROJECT, WANDB_ENTITY
environment             = "SHARPNESS_DEVICE=cuda WANDB_MODE=online WANDB_NAME=sharpness-$(ClusterId)-$(ProcId) OMP_NUM_THREADS=2 MKL_NUM_THREADS=2"
transfer_executable     = True
transfer_input_files    = $(project_dir)/test.py, $(project_dir)/src
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Remapping directories is unsupported; the runner archives results on exit.
transfer_output_files   = results.tar.gz
transfer_output_remaps  = "results.tar.gz=$(result_dir)/$(ClusterId).$(ProcId).tar.gz"

output                  = $(log_dir)/test.$(ClusterId).$(ProcId).out
error                   = $(log_dir)/test.$(ClusterId).$(ProcId).err
log                     = $(log_dir)/test.$(ClusterId).log

request_cpus            = 2
request_memory          = 8GB
request_disk            = 4GB
request_gpus            = 1

queue 1
