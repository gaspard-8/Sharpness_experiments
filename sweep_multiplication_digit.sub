# Submit through bash submit-multiplication-digit-sweep.sh after spectrum preparation.
project_dir             = /nethome/gtomas/projects/sharpness_experiments
log_dir                 = /scratch/gtomas/logs/sharpness_experiments
result_dir              = /scratch/gtomas/sharpness_experiments/results
image                   = docker.coli.uni-saarland.de/gtomas/sharpness-experiments:v1
experiment_args         =

universe                = docker
docker_image            = $(image)
initialdir              = /nethome/gtomas
executable              = $(project_dir)/run-test.sh
arguments               = --run-index $(Process) --wandb-group multiplication-hundreds-sweep-$(ClusterId) $(experiment_args)

getenv                  = WANDB_API_KEY, WANDB_PROJECT, WANDB_ENTITY
environment             = "SHARPNESS_DEVICE=cuda WANDB_MODE=online SHARPNESS_CPUS=$(request_cpus) SHARPNESS_ENTRYPOINT=sweep_multiplication_digit.py"
transfer_executable     = True
transfer_input_files    = $(project_dir)/sweep_multiplication_digit.py, $(project_dir)/test_multiplication_digit.py, $(project_dir)/src, $(project_dir)/multiplication_fourier_targets
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = results.tar.gz
transfer_output_remaps  = "results.tar.gz=$(result_dir)/$(ClusterId).$(ProcId).tar.gz"

output                  = $(log_dir)/multiplication-digit-sweep.$(ClusterId).$(ProcId).out
error                   = $(log_dir)/multiplication-digit-sweep.$(ClusterId).$(ProcId).err
log                     = $(log_dir)/multiplication-digit-sweep.$(ClusterId).log

request_cpus            = 2
request_memory          = 16GB
request_disk            = 16GB
request_gpus            = 1
gpus_minimum_memory     = 64000

queue 9
